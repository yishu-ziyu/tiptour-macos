# Copy to `.env` (git-ignored) and fill in real values.
# `.env` is only read by local development tools such as the protocol probes.
# The app itself never reads this file — it stores provider keys in the
# macOS Keychain through the onboarding / Settings UI.

# --- StepFun (阶跃星辰) ---------------------------------------------------
# One key covers BOTH the realtime voice model and the vision "eye" model.
# Create at https://platform.stepfun.com/interface-key
#
# Two different routes exist and they bill different accounts:
#   Open platform  : wss://api.stepfun.com/v1/realtime
#                    -> stepaudio-3-realtime-preview (currently free),
#                       stepaudio-2.5-realtime, ...
#   Step Plan      : wss://api.stepfun.com/step_plan/v1/realtime
#                    -> only stepaudio-2.5-realtime, billed against the
#                       subscription's credit balance
# The probes exercise both routes with the same key.
STEPFUN_API_KEY=

# --- TypeSafe (JEV) ------------------------------------------------------
# The "hand" model that picks which locally detected control to click.
# Early access, hosted at api.typesafe.ai. Leave empty to skip JEV probes.
TYPESAFE_API_KEY=

# --- Optional: OpenRouter ------------------------------------------------
# Alternative route to JEV (model id `typesafe/jev-1.13`), useful for
# comparing latency and price against the first-party endpoint.
OPENROUTER_API_KEY=
